#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export MAGNET_AGENT_ENV="$ROOT"
export VIRTUAL_ENV="$ROOT/env"
export UV_CACHE_DIR="$ROOT/state/uv-cache"
export UV_PYTHON_INSTALL_DIR="$ROOT/state/uv-python"
export UV_TOOL_DIR="$ROOT/state/uv-tools"
export UV_TOOL_BIN_DIR="$ROOT/state/uv-tool-bin"
export UV_LINK_MODE=copy
export PIP_CACHE_DIR="$ROOT/state/pip-cache"
export NPM_CONFIG_CACHE="$ROOT/state/npm-cache"
export NPM_CONFIG_PREFIX="$ROOT/state/npm-global"
export PYTHONPYCACHEPREFIX="$ROOT/state/pycache"
mkdir -p "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$UV_TOOL_DIR" "$UV_TOOL_BIN_DIR" "$PIP_CACHE_DIR" "$NPM_CONFIG_CACHE" "$NPM_CONFIG_PREFIX" "$PYTHONPYCACHEPREFIX" "$ROOT/state/postgres" "$ROOT/state/postgrest" 2>/dev/null || true
export PATH="$ROOT/env/bin:$ROOT/bin:$UV_TOOL_BIN_DIR:$NPM_CONFIG_PREFIX/bin:$PATH"

usage() {
  cat <<'USAGE'
Usage: agent-env COMMAND [ARGS...]

Commands:
  doctor [--json]          Diagnose bundle/host capabilities factually
  capabilities [--json]    Show bundled capability manifest
  postgres run [...] -- C  Run one command against a disposable local PostgreSQL
  pg TOOL [ARGS...]        Run an explicitly selected bundled PostgreSQL client tool
  pgtap FILE...            Run pgTAP SQL files with strict TAP accounting
  postgrest run [...] -- C Run one command against bounded local PostgREST
  pg-delta plan [...]      Generate a local-only PostgreSQL schema migration plan
  node-deps CMD            status|hydrate|clean exact repository-locked offline capsules
  github                   Probe shell GitHub reachability, auth/API, and repo access
  github-auth              Run browser/device GitHub OAuth when reachable, then verify it
  github-git               Configure current-repo Git auth safely and verify push dry-run
  git-handoff restore Z D  Restore a validated Git bundle handoff into a fresh worktree
  git [ARGS...]            Run host Git with this environment active
  selftest                 Exercise bundled capabilities and portability invariants
  verify                   Verify immutable payload checksums and symlink topology
  repair                   Repair relocation-sensitive Python venv metadata
  rebuild-python           Recreate the Python venv entirely offline from wheelhouse
  versions                 Print the pinned environment manifest
  exec CMD [ARGS...]       Run a command with this environment active
  root                     Print the resolved bundle root
  help                     Show this command surface
USAGE
}

pg_exec() {
  local tool="${1:-}"
  [[ -n "$tool" ]] || { echo "agent-env pg requires a tool name" >&2; exit 2; }
  shift
  case "$tool" in
    psql|pg_isready|pgbench|pg_dump|pg_restore|pg_dumpall|pg_amcheck|pg_checksums|createdb|dropdb) ;;
    *) echo "Unsupported bundled PostgreSQL client tool: $tool" >&2; exit 2 ;;
  esac
  local bin="$ROOT/runtime/postgres/client/bin/$tool"
  [[ -x "$bin" ]] || { echo "Bundled PostgreSQL client tool missing: $bin" >&2; exit 1; }
  export LD_LIBRARY_PATH="$ROOT/runtime/postgres/client/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  exec "$bin" "$@"
}

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help) usage ;;
  doctor) shift; exec "$ROOT/env/bin/python" "$ROOT/scripts/doctor.py" "$@" ;;
  capabilities) shift; exec "$ROOT/env/bin/python" "$ROOT/scripts/capabilities.py" "$@" ;;
  postgres)
    shift
    sub="${1:-}"
    [[ "$sub" == run ]] || { echo "Usage: agent-env postgres run [--port N] [--keep] [--bootstrap-user NAME] -- COMMAND" >&2; exit 2; }
    shift
    exec "$ROOT/env/bin/python" "$ROOT/scripts/postgres.py" "$@"
    ;;
  pg) shift; pg_exec "$@" ;;
  pgtap) shift; exec "$ROOT/env/bin/python" "$ROOT/scripts/pgtap.py" "$@" ;;
  postgrest)
    shift
    sub="${1:-}"
    [[ "$sub" == run ]] || { echo "Usage: agent-env postgrest run --db-uri postgresql://... --db-schemas SCHEMAS --db-anon-role ROLE [--db-extra-search-path PATH] [--db-pre-request FUNCTION] [--port N] -- COMMAND" >&2; exit 2; }
    shift
    exec "$ROOT/env/bin/python" "$ROOT/scripts/postgrest.py" "$@"
    ;;
  pg-delta)
    shift
    sub="${1:-}"
    [[ "$sub" == plan ]] || { echo "Usage: agent-env pg-delta plan --source postgresql://... --target postgresql://... --out DIR" >&2; exit 2; }
    shift
    exec "$ROOT/runtime/node/bin/node" "$ROOT/runtime/pg-delta/plan.mjs" "$@"
    ;;
  node-deps) shift; exec "$ROOT/env/bin/python" "$ROOT/scripts/node-deps.py" "$@" ;;
  github) shift; exec "$ROOT/scripts/github.sh" status "$@" ;;
  github-auth) shift; exec "$ROOT/scripts/github.sh" auth "$@" ;;
  github-git) shift; exec "$ROOT/scripts/github.sh" git "$@" ;;
  git-handoff)
    shift
    sub="${1:-}"
    [[ "$sub" == restore ]] || { echo "Usage: agent-env git-handoff restore ARTIFACT.zip DEST" >&2; exit 2; }
    shift
    exec "$ROOT/env/bin/python" "$ROOT/scripts/git-handoff.py" restore "$@"
    ;;
  git)
    shift
    command -v git >/dev/null 2>&1 || { echo "Host Git is unavailable." >&2; exit 1; }
    exec git "$@"
    ;;
  selftest) shift; exec "$ROOT/scripts/selftest.sh" "$@" ;;
  verify) shift; exec "$ROOT/scripts/verify.sh" "$@" ;;
  repair) shift; exec "$ROOT/scripts/repair-python.sh" "$@" ;;
  rebuild-python) shift; exec "$ROOT/scripts/rebuild-python.sh" "$@" ;;
  versions) cat "$ROOT/manifest/environment.json" ;;
  root) printf '%s\n' "$ROOT" ;;
  exec)
    shift
    [[ $# -gt 0 ]] || { echo "agent-env exec requires a command" >&2; exit 2; }
    exec "$@"
    ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
