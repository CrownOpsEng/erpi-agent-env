#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export MAGNET_AGENT_ENV="$ROOT"
export VIRTUAL_ENV="$ROOT/env"
export UV_CACHE_DIR="$ROOT/state/uv-cache"
export UV_PYTHON_INSTALL_DIR="$ROOT/state/uv-python"
export UV_TOOL_DIR="$ROOT/state/uv-tools"
export UV_TOOL_BIN_DIR="$ROOT/state/uv-tool-bin"
export UV_LINK_MODE=copy
export PIP_CACHE_DIR="$ROOT/state/pip-cache"
export NPM_CONFIG_CACHE="$ROOT/state/npm-cache"
export NPM_CONFIG_PREFIX="$ROOT/state/npm-global"
export PYTHONPYCACHEPREFIX="$ROOT/state/pycache"
mkdir -p "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$UV_TOOL_DIR" "$UV_TOOL_BIN_DIR" "$PIP_CACHE_DIR" "$NPM_CONFIG_CACHE" "$NPM_CONFIG_PREFIX" "$PYTHONPYCACHEPREFIX" 2>/dev/null || true
export PATH="$ROOT/env/bin:$ROOT/bin:$UV_TOOL_BIN_DIR:$NPM_CONFIG_PREFIX/bin:$PATH"

usage() {
  cat <<'USAGE'
Usage: agent-env COMMAND [ARGS...]

Commands:
  doctor [--json]    Diagnose local bundle, host commands, and current repository
  github             Validate GitHub auth/API and current-repository access
  github-auth        Run browser/device GitHub OAuth when needed, then verify it
  github-git         Configure current-repo Git auth safely and verify push dry-run
  git [ARGS...]      Run host Git with this environment active
  selftest           Exercise bundled capabilities and portability invariants
  verify             Verify immutable payload checksums and symlink topology
  repair             Repair relocation-sensitive Python venv metadata
  rebuild-python     Recreate the Python venv entirely offline from wheelhouse
  versions           Print the pinned environment manifest
  exec CMD [ARGS...] Run a command with this environment active
  root               Print the resolved bundle root
  help               Show this command surface
USAGE
}

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help) usage ;;
  doctor) shift; exec "$ROOT/env/bin/python" "$ROOT/scripts/doctor.py" "$@" ;;
  github) shift; exec "$ROOT/scripts/github.sh" status "$@" ;;
  github-auth) shift; exec "$ROOT/scripts/github.sh" auth "$@" ;;
  github-git) shift; exec "$ROOT/scripts/github.sh" git "$@" ;;
  git)
    shift
    command -v git >/dev/null 2>&1 || { echo "Host Git is unavailable." >&2; exit 1; }
    exec git "$@"
    ;;
  selftest) shift; exec "$ROOT/scripts/selftest.sh" "$@" ;;
  verify) shift; exec "$ROOT/scripts/verify.sh" "$@" ;;
  repair) shift; exec "$ROOT/scripts/repair-python.sh" "$@" ;;
  rebuild-python) shift; exec "$ROOT/scripts/rebuild-python.sh" "$@" ;;
  versions) cat "$ROOT/manifest/environment.json" ;;
  root) printf '%s\n' "$ROOT" ;;
  exec)
    shift
    [[ $# -gt 0 ]] || { echo "agent-env exec requires a command" >&2; exit 2; }
    exec "$@"
    ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
